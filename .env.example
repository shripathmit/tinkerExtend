# Copy to .env and fill in. Never commit the real file.
# export $(cat .env | xargs)   # then run the CLI
EXTEND_API_KEY=REPLACE_ME
EXTEND_API_VERSION=2026-02-09
# EXTEND_WORKSPACE_ID=
# TINKER_KB_PATH=./kb.sqlite3
# --- optional: generated answers in the web UI (any OpenAI-compatible endpoint)
# TINKER_LLM_API_KEY=
# TINKER_LLM_BASE_URL=https://api.openai.com/v1
# TINKER_LLM_MODEL=gpt-4o-mini
# --- admin console access code (default: extend). Change it in production.
# TINKER_ADMIN_CODE=extend
# --- embeddings for hybrid search (local model, no API key)
# TINKER_EMBEDDINGS=on                       # "off" = keyword search only
# TINKER_EMBED_MODEL=BAAI/bge-small-en-v1.5
# TINKER_EMBED_CACHE=/data/models            # persistent volume: avoids re-download per deploy
# TINKER_MIN_SIM=0.80                        # cosine needed to answer from a vector-only match
